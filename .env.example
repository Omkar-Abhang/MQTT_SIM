# ---- MQTT broker (what the simulated devices connect to) ----
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# 3.1.1 is what the real ESP devices speak. 5 for brokers/tests that need it
MQTT_PROTOCOL=3.1.1
MQTT_KEEPALIVE=60
# real devices publish with QoS 0
MQTT_QOS=0
MQTT_CLEAN_SESSION=true
# client id = prefix + MAC, like the real devices (IES-84:1F:E8:...)
MQTT_CLIENT_ID_PREFIX=IES-
# topics: <prefix>/<TYPE>/<SERIAL>/<channel>
MQTT_TOPIC_PREFIX=IES

# ---- TLS ----
MQTT_TLS=false
# CA that signed the broker certificate (empty = system CAs)
MQTT_TLS_CA_CERT=
# only for brokers that require client certificates
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
# true = encrypt but do not verify the broker certificate (self-signed / connecting by IP)
MQTT_TLS_INSECURE=false

# ---- connections ----
# per_device = one MQTT connection per simulated device (what EMQX sees from a real fleet)
# shared     = MQTT_SHARED_CONNECTIONS connections carry all devices (same message load, far fewer connections)
MQTT_CONNECTION_MODE=per_device
MQTT_SHARED_CONNECTIONS=20
# new connections per second while ramping up (be gentle with the broker)
MQTT_CONNECT_RATE=100
MQTT_RECONNECT_DELAY=5

# ---- fleet ----
ACCON_COUNT=1000
CO2TH_COUNT=1000
# YYMM part of the serial: IACCON-<batch>-0001, CO2TH-<batch>-0001. 9999 is not a real month, so simulated
# devices are always recognisable (and easy to purge downstream)
SERIAL_BATCH=9999
ACCON_FIRMWARE=1.3.4-R
# empty = 1.0.1 for legacy, 1.0.2 for iesmq-v1
CO2TH_FIRMWARE=
# legacy   = /metrics + the heartbeat seen on the fleet (firmware 1.0.1)
# iesmq-v1 = /data + the richer heartbeat of the newer firmware (1.0.2)
CO2TH_PROTOCOL=legacy

# ---- timing ----
METRICS_INTERVAL_SECONDS=60
HB_INTERVAL_SECONDS=900
# 10 = everything runs 10x faster than real time (load testing)
INTERVAL_SCALE=1
# 0 = run until stopped (Ctrl-C / SIGTERM)
DURATION_SECONDS=0

# ---- faults, to exercise the receiver (percent of messages) ----
# garbled / RTC-reset / empty / seconds=60 timestamps, as seen on real devices
BAD_TS_PERCENT=0
DUPLICATE_PERCENT=0
RANDOM_SEED=1
STATS_INTERVAL_SECONDS=10
TZ=Asia/Kolkata
